# ==============================================================================
# FILE .env.example - File mẫu để chia sẻ với team (KHÔNG có giá trị thật)
# ==============================================================================
# Hướng dẫn: Copy file này thành file ".env" rồi điền giá trị thật vào.
#   cp .env.example .env
# ==============================================================================

DATABASE_URL=mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
SECRET_KEY=<your-random-secret-key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
